# Copy to .env.prod and fill in real values before running
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Never commit .env.prod.

DOMAIN=valet.example.com
API_DOMAIN=api.valet.example.com
ACME_EMAIL=ops@example.com

POSTGRES_USER=valet
POSTGRES_PASSWORD=
POSTGRES_DB=valet

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Optional: SMS and support assistant adapters. Leave blank to run with
# the console/rule-based fallbacks.
TWILIO_AUTH_TOKEN=
ANTHROPIC_API_KEY=
# Model ID for the live support assistant, required alongside the API key
SUPPORT_MODEL=
